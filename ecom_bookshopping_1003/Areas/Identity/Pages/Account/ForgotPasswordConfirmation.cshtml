@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Password Reset Link Sent - BookKart";
}

<div class="row justify-content-center py-5">
    <div class="col-12 col-md-8 col-lg-5">

        <!-- Confirmation Card -->
        <div class="card border-0 shadow-sm rounded-3 overflow-hidden bg-white text-center">

            <!-- Navy Header matching BookKart Theme -->
            <div class="card-header bg-fk-navy text-white text-center py-4 border-0" style="background-color: #0b1f3a;">
                <div class="brand-icon-box mx-auto mb-2 bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 52px; height: 52px; background-color: #2874f0 !important;">
                    <i class="fa-solid fa-paper-plane fs-4"></i>
                </div>
                <h4 class="fw-bold mb-1">Check Your Email</h4>
                <p class="fs-7 text-slate-300 mb-0 opacity-75">Password reset instructions have been sent</p>
            </div>

            <div class="card-body p-4 p-lg-5">
                <!-- Success Mail Icon Animation Box -->
                <div class="mb-4">
                    <div class="rounded-circle bg-success-subtle text-success mx-auto d-flex align-items-center justify-content-center" style="width: 76px; height: 76px;">
                        <i class="fa-solid fa-envelope-circle-check fa-3x"></i>
                    </div>
                </div>

                <h4 class="fw-bold text-dark mb-2">Reset Link Sent Successfully!</h4>
                <p class="text-muted fs-7 mb-4">
                    Humne aapke registered email address par password reset karne ka link bhej diya hai. Kripya apna inbox (aur spam folder) check karein aur link par click karke naya password set karein.
                </p>

                <!-- Helpful Tip Box -->
                <div class="alert alert-light border text-start fs-8 text-secondary mb-4 p-3 rounded-2">
                    <div class="d-flex align-items-start">
                        <i class="fa-solid fa-circle-info text-primary mt-1 me-2 fs-6"></i>
                        <div>
                            <strong>Email nahi mila?</strong> Kuch minutes wait karein ya check karein ki aapne sahi email address enter kiya tha.
                        </div>
                    </div>
                </div>

                <!-- Navigation Buttons -->
                <div class="d-grid gap-2">
                    <a asp-page="./Login" class="btn btn-warning text-white fw-bold py-3 rounded-3 fs-6 shadow-sm" style="background-color: #ff9f00; border: none;">
                        <i class="fa-solid fa-arrow-left me-2"></i> Back to Sign In
                    </a>
                    <a href="~/" class="btn btn-outline-secondary py-2 mt-1 rounded-3 fs-7">
                        Go to Homepage
                    </a>
                </div>
            </div>

            <!-- Footer Strip -->
            <div class="card-footer bg-light border-0 py-3 text-muted fs-8">
                <i class="fa-solid fa-shield-halved text-success me-1"></i> 100% Secure Account Recovery • BookKart
            </div>

        </div>

    </div>
</div>