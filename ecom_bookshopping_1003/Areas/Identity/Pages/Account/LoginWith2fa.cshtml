@page
@model LoginWith2faModel
@{
    ViewData["Title"] = "Email Verification";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-8 col-lg-5">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-body p-4 p-md-5">

                    <div class="text-center mb-4">
                        <div class="mb-3">
                            <i class="fas fa-shield-alt text-primary fa-3x"></i>
                        </div>
                        <h3 class="fw-bold">@ViewData["Title"]</h3>
                        <p class="text-muted small">
                            Humne aapke email <strong class="text-dark">@Model.MaskedEmail</strong> par 6 digit OTP bheja hai.
                        </p>
                    </div>

                    @if (ViewData["ResendMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show text-center py-2 mb-3" role="alert">
                            <i class="fas fa-check-circle me-1"></i> @ViewData["ResendMessage"]
                            <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
                        <input asp-for="RememberMe" type="hidden" />
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3 text-center" role="alert"></div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.TwoFactorCode"
                                   class="form-control text-center fw-bold fs-4"
                                   style="letter-spacing: 8px;"
                                   placeholder="123456"
                                   autocomplete="one-time-code"
                                   inputmode="numeric"
                                   maxlength="6"
                                   autofocus />
                            <label asp-for="Input.TwoFactorCode">Enter 6-Digit OTP</label>
                            <span asp-validation-for="Input.TwoFactorCode" class="text-danger small"></span>
                        </div>

                        <div class="form-check mb-4">
                            <input asp-for="Input.RememberMachine" class="form-check-input" />
                            <label asp-for="Input.RememberMachine" class="form-check-label small text-muted">
                                Remember this device
                            </label>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold shadow-sm mb-3">
                            Verify & Login
                        </button>
                    </form>

                    <div class="text-center border-top pt-3 mt-2">
                        <p class="text-muted small mb-1">Didn't receive code?</p>
                        <form method="post" asp-page-handler="Resend" asp-route-returnUrl="@Model.ReturnUrl">
                            <input type="hidden" name="rememberMe" value="@Model.RememberMe" />
                            <button type="submit" class="btn btn-outline-secondary btn-sm px-3">
                                <i class="fas fa-redo-alt me-1"></i> Resend OTP
                            </button>
                        </form>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}