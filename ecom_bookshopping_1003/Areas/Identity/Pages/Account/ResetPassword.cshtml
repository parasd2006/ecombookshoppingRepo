@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Reset Password - BookKart";
}

<div class="row justify-content-center py-4">
    <div class="col-12 col-md-8 col-lg-5">

        <!-- Auth Card -->
        <div class="card border-0 shadow-sm rounded-3 overflow-hidden bg-white">

            <!-- Navy Header matching Login Theme -->
            <div class="card-header bg-fk-navy text-white text-center py-4 border-0" style="background-color: #0b1f3a;">
                <div class="brand-icon-box mx-auto mb-2 bg-primary text-white rounded d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; background-color: #2874f0 !important;">
                    <i class="fa-solid fa-lock-open fs-4"></i>
                </div>
                <h4 class="fw-bold mb-1">Set New Password</h4>
                <p class="fs-7 text-slate-300 mb-0 opacity-75">Create a strong password for your BookKart account</p>
            </div>

            <div class="card-body p-4 p-lg-5">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3 fs-7" role="alert"></div>

                    <input asp-for="Input.Code" type="hidden" />

                    <!-- Email Input -->
                    <div class="form-floating mb-3">
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" readonly />
                        <label asp-for="Input.Email">Email Address</label>
                        <span asp-validation-for="Input.Email" class="text-danger fs-8"></span>
                    </div>

                    <!-- New Password Input -->
                    <div class="form-floating mb-3">
                        <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Enter new password" />
                        <label asp-for="Input.Password">New Password</label>
                        <span asp-validation-for="Input.Password" class="text-danger fs-8"></span>
                    </div>

                    <!-- Confirm New Password Input -->
                    <div class="form-floating mb-4">
                        <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Confirm new password" />
                        <label asp-for="Input.ConfirmPassword">Confirm New Password</label>
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger fs-8"></span>
                    </div>

                    <!-- Submit Button -->
                    <div class="mb-3">
                        <button type="submit" class="w-100 btn btn-fk-buy btn-lg py-3 rounded-3 fs-6">
                            Reset Password & Continue
                        </button>
                    </div>

                    <!-- Navigation back to Login -->
                    <div class="text-center mt-4 pt-3 border-top fs-7">
                        <span class="text-muted">Already know your password?</span>
                        <a asp-page="./Login" class="text-primary text-decoration-none fw-bold ms-1">
                            Back to Sign In
                        </a>
                    </div>
                </form>
            </div>

            <!-- Footer Strip -->
            <div class="card-footer bg-light border-0 py-3 text-center text-muted fs-8">
                <i class="fa-solid fa-shield-halved text-success me-1"></i> End-to-End Encrypted Password Protection
            </div>

        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}