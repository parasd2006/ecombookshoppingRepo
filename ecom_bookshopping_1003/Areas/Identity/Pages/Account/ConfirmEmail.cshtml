@page
@model ConfirmEmailModel
@{
    ViewData["Title"] = "Email Confirmation - BookKart";
}

<div class="row justify-content-center py-5">
    <div class="col-12 col-md-8 col-lg-5">

        <!-- Confirmation Card -->
        <div class="card border-0 shadow-sm rounded-3 overflow-hidden bg-white text-center">

            <!-- Navy Header matching BookKart Theme -->
            <div class="card-header bg-fk-navy text-white text-center py-4 border-0" style="background-color: #0b1f3a;">
                <div class="brand-icon-box mx-auto mb-2 bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 52px; height: 52px; background-color: #2874f0 !important;">
                    <i class="fa-solid fa-book-open fs-4"></i>
                </div>
                <h4 class="fw-bold mb-1">BookKart Account Verification</h4>
                <p class="fs-7 text-slate-300 mb-0 opacity-75">Your trusted online bookstore</p>
            </div>

            <div class="card-body p-4 p-lg-5">

                @if (Model.StatusMessage != null && Model.StatusMessage.Contains("Error", StringComparison.OrdinalIgnoreCase))
                {
                    <!-- Error State -->
                    <div class="mb-4">
                        <div class="rounded-circle bg-danger-subtle text-danger mx-auto d-flex align-items-center justify-content-center" style="width: 72px; height: 72px;">
                            <i class="fa-solid fa-circle-xmark fa-2x"></i>
                        </div>
                    </div>

                    <h5 class="fw-bold text-danger mb-2">Verification Failed</h5>
                    <p class="text-muted fs-7 mb-4">
                        Aapka verification link invalid ya expire ho chuka hai. Kripya login page par jakar naya link generate karein.
                    </p>

                    <a asp-page="./Login" class="btn btn-primary w-100 py-2 fw-medium rounded-2" style="background-color: #2874f0; border: none;">
                        Back to Login
                    </a>
                }
                else
                {
                    <!-- Success State -->
                    <div class="mb-4">
                        <div class="rounded-circle bg-success-subtle text-success mx-auto d-flex align-items-center justify-content-center" style="width: 76px; height: 76px;">
                            <i class="fa-solid fa-circle-check fa-3x"></i>
                        </div>
                    </div>

                    <h4 class="fw-bold text-dark mb-2">Email Verified Successfully!</h4>
                    <p class="text-muted fs-7 mb-4">
                        Aapka account successfully verify ho chuka hai. Aap BookKart ke orders, wishlist aur exclusive deals access kar sakte hain.
                    </p>

                    <div class="d-grid gap-2">
                        <a href="~/" class="btn btn-warning text-white fw-bold py-3 rounded-3 fs-6 shadow-sm" style="background-color: #ff9f00; border: none;">
                            <i class="fa-solid fa-bag-shopping me-2"></i> Start Shopping
                        </a>
                        <a asp-page="./Login" class="btn btn-outline-secondary py-2 mt-1 rounded-3 fs-7">
                            Go to Login
                        </a>
                    </div>
                }

            </div>

            <!-- Footer Strip -->
            <div class="card-footer bg-light border-0 py-3 text-muted fs-8">
                <i class="fa-solid fa-shield-halved text-success me-1"></i> 100% Secure Verification with BookKart
            </div>

        </div>

    </div>
</div>