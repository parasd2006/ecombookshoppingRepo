@page
@model RegisterModel
@using ecom_bookshopping_1003.Utility;

@{
    ViewData["Title"] = "Create Account - BookKart";
}

<div class="row justify-content-center py-4">
    <div class="col-12 col-md-10 col-lg-7">
        
        <!-- Register Card -->
        <div class="card border-0 shadow-sm rounded-3 overflow-hidden bg-white">
            <div class="card-header bg-fk-navy text-white text-center py-4 border-0">
                <div class="brand-icon-box mx-auto mb-2 bg-primary text-white rounded d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                    <i class="fa-solid fa-user-plus fs-4"></i>
                </div>
                <h4 class="fw-bold mb-1">Create Your BookKart Account</h4>
                <p class="fs-7 text-slate-300 mb-0">Join millions of book lovers and get access to exclusive volume discounts</p>
            </div>

            <div class="card-body p-4 p-lg-5">
                <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3 fs-7" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-12 col-sm-6">
                            <div class="form-floating">
                                <input asp-for="Input.Name" class="form-control" placeholder="Full Name" />
                                <label asp-for="Input.Name">Full Name</label>
                                <span asp-validation-for="Input.Name" class="text-danger fs-8"></span>
                            </div>
                        </div>

                        <div class="col-12 col-sm-6">
                            <div class="form-floating">
                                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                                <label asp-for="Input.Email">Email Address</label>
                                <span asp-validation-for="Input.Email" class="text-danger fs-8"></span>
                            </div>
                        </div>

                        <div class="col-12 col-sm-6">
                            <div class="form-floating">
                                <input asp-for="Input.PhoneNumber" class="form-control" placeholder="Phone Number" />
                                <label asp-for="Input.PhoneNumber">Phone Number</label>
                                <span asp-validation-for="Input.PhoneNumber" class="text-danger fs-8"></span>
                            </div>
                        </div>

                        <div class="col-12 col-sm-6">
                            <div class="form-floating">
                                <input asp-for="Input.StreetAddress" class="form-control" placeholder="Street Address" />
                                <label asp-for="Input.StreetAddress">Street Address</label>
                                <span asp-validation-for="Input.StreetAddress" class="text-danger fs-8"></span>
                            </div>
                        </div>

                        <div class="col-12 col-sm-4">
                            <div class="form-floating">
                                <input asp-for="Input.City" class="form-control" placeholder="City" />
                                <label asp-for="Input.City">City</label>
                                <span asp-validation-for="Input.City" class="text-danger fs-8"></span>
                            </div>
                        </div>

                        <div class="col-12 col-sm-4">
                            <div class="form-floating">
                                <input asp-for="Input.State" class="form-control" placeholder="State" />
                                <label asp-for="Input.State">State</label>
                                <span asp-validation-for="Input.State" class="text-danger fs-8"></span>
                            </div>
                        </div>

                        <div class="col-12 col-sm-4">
                            <div class="form-floating">
                                <input asp-for="Input.PostalCode" class="form-control" placeholder="Postal Code" />
                                <label asp-for="Input.PostalCode">Postal Code</label>
                                <span asp-validation-for="Input.PostalCode" class="text-danger fs-8"></span>
                            </div>
                        </div>

                        <div class="col-12 col-sm-6">
                            <div class="form-floating">
                                <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" />
                                <label asp-for="Input.Password">Password</label>
                                <span asp-validation-for="Input.Password" class="text-danger fs-8"></span>
                            </div>
                        </div>

                        <div class="col-12 col-sm-6">
                            <div class="form-floating">
                                <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" />
                                <label asp-for="Input.ConfirmPassword">Confirm Password</label>
                                <span asp-validation-for="Input.ConfirmPassword" class="text-danger fs-8"></span>
                            </div>
                        </div>

                        @if (User.IsInRole(SD.Role_Admin))
                        {
                            <div class="col-12 col-sm-6">
                                <div class="form-floating">
                                    <select asp-for="Input.Role" class="form-select" asp-items="@Model.Input.Rolelist">
                                        <option value="">Select Assign Role</option>
                                    </select>
                                    <label asp-for="Input.Role">System Role</label>
                                    <span asp-validation-for="Input.Role" class="text-danger fs-8"></span>
                                </div>
                            </div>

                            <div class="col-12 col-sm-6">
                                <div class="form-floating">
                                    <select asp-for="Input.CompanyId" class="form-select" asp-items="@Model.Input.CompanyList">
                                        <option value="">Select Company Account</option>
                                    </select>
                                    <label asp-for="Input.CompanyId">Corporate Company</label>
                                    <span asp-validation-for="Input.CompanyId" class="text-danger fs-8"></span>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="mt-4">
                        <button id="registerSubmit" type="submit" class="w-100 btn btn-fk-buy btn-lg py-3 rounded-3 fs-6">Create Account</button>
                    </div>

                    <div class="text-center mt-4 pt-3 border-top fs-7">
                        <span class="text-muted">Already registered on BookKart?</span>
                        <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="text-primary text-decoration-none fw-bold ms-1">Sign In Here</a>
                    </div>
                </form>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
