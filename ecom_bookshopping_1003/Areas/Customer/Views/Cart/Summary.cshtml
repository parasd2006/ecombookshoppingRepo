@using Microsoft.Extensions.Options
@model ecom_bookshopping_1003.Models.ViewModels.ShoppingCartVM
@inject IOptions<ecom_bookshopping_1003.Utility.StripeSettings> Stripe;

@{
    ViewData["Title"] = "Order Checkout & Summary - BookKart";
}

<!-- Checkout Header -->
<div class="d-flex align-items-center justify-content-between mb-4">
    <h4 class="fw-extrabold text-dark mb-0">
        <i class="fa-solid fa-credit-card text-primary me-2"></i> Order Checkout & Summary
    </h4>
    <a asp-action="Index" asp-controller="Cart" class="btn btn-outline-primary btn-sm font-semibold rounded-pill px-3">
        <i class="fa-solid fa-arrow-left me-1"></i> Back to Cart
    </a>
</div>

<form method="post">
    <input type="hidden" name="selectedIds" value="@Context.Request.Query["selectedIds"]" />
    
    <div class="row g-4">
        
        <!-- Left Column: Shipping & Pickup Address Form -->
        <div class="col-12 col-lg-7">
            <div class="cart-card-shadow p-4">
                
                <div class="d-flex align-items-center gap-2 border-bottom pb-3 mb-4">
                    <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 28px; height: 28px; font-size: 14px;">1</div>
                    <h5 class="fw-bold text-dark mb-0">Shipping & Delivery Details</h5>
                </div>

                <!-- Saved Address Dropdown -->
                <div class="mb-4 p-3 bg-light rounded border">
                    <label class="form-label text-dark fw-bold fs-7 mb-2">
                        <i class="fa-solid fa-location-dot text-danger me-1"></i> Select Saved Address:
                    </label>
                    <select id="ddlAddress" class="form-select border-secondary-subtle">
                        <option value="">-- Choose Pre-saved Address --</option>
                        @if (Model.PreviousAddresses != null && Model.PreviousAddresses.Any())
                        {
                            foreach (var list in Model.PreviousAddresses)
                            {
                                <option value="@list.Id"
                                        data-name="@list.Name"
                                        data-phone="@list.PhoneNumber"
                                        data-street="@list.StreetAddress"
                                        data-city="@list.City"
                                        data-state="@list.State"
                                        data-postal="@list.PostalCode">
                                    @list.StreetAddress, @list.City, @list.State (@list.PostalCode)
                                </option>
                            }
                        }
                    </select>
                </div>

                <!-- Address Input Fields Grid -->
                <div class="row g-3">
                    <div class="col-12 col-sm-6">
                        <label class="form-label text-dark fw-semibold fs-7 mb-1">Full Name</label>
                        <input type="text" id="txtName" class="form-control py-2" asp-for="orderHeader.Name" placeholder="Enter full name" />
                        <span asp-validation-for="orderHeader.Name" class="text-danger fs-8"></span>
                    </div>

                    <div class="col-12 col-sm-6">
                        <label class="form-label text-dark fw-semibold fs-7 mb-1">Phone Number</label>
                        <input type="text" id="txtPhone" class="form-control py-2" asp-for="orderHeader.PhoneNumber" placeholder="Enter mobile phone" />
                        <span asp-validation-for="orderHeader.PhoneNumber" class="text-danger fs-8"></span>
                    </div>

                    <div class="col-12">
                        <label class="form-label text-dark fw-semibold fs-7 mb-1">Street Address</label>
                        <input type="text" id="txtStreet" class="form-control py-2" asp-for="orderHeader.StreetAddress" placeholder="Flat, House no., Building, Street" />
                        <span asp-validation-for="orderHeader.StreetAddress" class="text-danger fs-8"></span>
                    </div>

                    <div class="col-12 col-sm-4">
                        <label class="form-label text-dark fw-semibold fs-7 mb-1">City</label>
                        <input type="text" id="txtCity" class="form-control py-2" asp-for="orderHeader.City" placeholder="City" />
                        <span asp-validation-for="orderHeader.City" class="text-danger fs-8"></span>
                    </div>

                    <div class="col-12 col-sm-4">
                        <label class="form-label text-dark fw-semibold fs-7 mb-1">State</label>
                        <input type="text" id="txtState" class="form-control py-2" asp-for="orderHeader.State" placeholder="State" />
                        <span asp-validation-for="orderHeader.State" class="text-danger fs-8"></span>
                    </div>

                    <div class="col-12 col-sm-4">
                        <label class="form-label text-dark fw-semibold fs-7 mb-1">Postal Code</label>
                        <input type="text" id="txtPostal" class="form-control py-2" asp-for="orderHeader.PostalCode" placeholder="Pincode" />
                        <span asp-validation-for="orderHeader.PostalCode" class="text-danger fs-8"></span>
                    </div>
                </div>

            </div>
        </div>

        <!-- Right Column: Order Items Summary & Payment Button -->
        <div class="col-12 col-lg-5">
            <div class="cart-card-shadow p-4 position-sticky" style="top: 90px;">
                
                <div class="d-flex align-items-center gap-2 border-bottom pb-3 mb-3">
                    <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 28px; height: 28px; font-size: 14px;">2</div>
                    <h5 class="fw-bold text-dark mb-0">Order Summary</h5>
                </div>

                <!-- Items Breakdown List -->
                <ul class="list-group list-group-flush mb-3">
                    @foreach (var list in Model.ListCart)
                    {
                        <li class="list-group-item px-0 py-2 border-bottom-subtle d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="my-0 font-bold text-dark fs-7 text-truncate" style="max-width: 220px;">@list.product.Title</h6>
                                <small class="text-muted fs-8">Qty: <strong>@list.Count</strong> x $@list.price.ToString("0.00")</small>
                            </div>
                            <span class="fw-bold text-dark fs-7">$@((list.price * list.Count).ToString("0.00"))</span>
                        </li>
                    }
                </ul>

                <!-- Bill Totals -->
                <div class="p-3 bg-light rounded border mb-3">
                    <div class="d-flex justify-content-between mb-2 fs-7">
                        <span class="text-muted">Items Subtotal</span>
                        <span class="fw-bold text-dark">$@Model.orderHeader.OrderTotal.ToString("0.00")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2 fs-7">
                        <span class="text-muted">Delivery Charges</span>
                        <span class="text-success fw-bold">FREE</span>
                    </div>
                    <hr class="my-2">
                    <div class="d-flex justify-content-between fs-5 fw-extrabold text-dark">
                        <span>Total Payable</span>
                        <span class="text-primary">$@Model.orderHeader.OrderTotal.ToString("0.00")</span>
                    </div>
                </div>

                <!-- Delivery Estimate Note -->
                <div class="p-2-5 bg-info-subtle text-info-emphasis rounded border border-info-subtle fs-8 mb-4">
                    <i class="fa-solid fa-truck-ramp-box me-1"></i> Estimated Delivery Window: 
                    <strong>@DateTime.Now.AddDays(7).ToShortDateString() - @DateTime.Now.AddDays(14).ToShortDateString()</strong>
                </div>

                <!-- Stripe Checkout Button Container -->
                @{
                    var orderTotalAmount = Model.orderHeader.OrderTotal * 100;
                }
                <script src="https://checkout.stripe.com/checkout.js"
                        class="stripe-button"
                        data-key="@Stripe.Value.PublishableKey"
                        data-amount="@orderTotalAmount"
                        data-name="BookKart E-Commerce"
                        data-description="Book Order Payment"
                        data-locale="auto"
                        data-label="Place Order"
                        data-allow-rememberme="false"
                        data-image="https://stripe.com/img/documentation/checkout/marketplace.png">
                </script>
                <script>
                    document.getElementsByClassName("stripe-button-el")[0].style.display = 'none';
                </script>

                <button type="submit" value="Place Order" class="btn btn-fk-buy btn-lg w-100 py-3 rounded-3 fs-6 tracking-wide">
                    <i class="fa-solid fa-lock me-2"></i> PLACE ORDER & PAY
                </button>

                <div class="mt-3 text-center fs-8 text-muted">
                    <i class="fa-solid fa-shield-halved text-success me-1"></i> 256-Bit SSL Encrypted Payment Gateway
                </div>

            </div>
        </div>

    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('ddlAddress').addEventListener('change', function () {
            var selectedOption = this.options[this.selectedIndex];

            if (this.value !== "") {
                document.getElementById('txtName').value = selectedOption.getAttribute('data-name') || '';
                document.getElementById('txtPhone').value = selectedOption.getAttribute('data-phone') || '';
                document.getElementById('txtStreet').value = selectedOption.getAttribute('data-street') || '';
                document.getElementById('txtCity').value = selectedOption.getAttribute('data-city') || '';
                document.getElementById('txtState').value = selectedOption.getAttribute('data-state') || '';
                document.getElementById('txtPostal').value = selectedOption.getAttribute('data-postal') || '';
            }
        });
    </script>
}