@model ecom_bookshopping_1003.Models.ViewModels.ShoppingCartVM

@{
    ViewData["Title"] = "Shopping Cart - BookKart";
}

<div class="container py-2">
    
    <!-- Title Header -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <h4 class="fw-extrabold text-dark mb-0">
            <i class="fa-solid fa-cart-shopping text-primary me-2"></i> Shopping Cart 
            <span class="fs-6 text-muted fw-normal">(@Model.ListCart.Count() Items)</span>
        </h4>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary btn-sm font-semibold rounded-pill px-3">
            <i class="fa-solid fa-arrow-left me-1"></i> Continue Shopping
        </a>
    </div>

    @if (!Model.ListCart.Any())
    {
        <div class="card border-0 shadow-sm p-5 text-center rounded-3 bg-white">
            <div class="mb-3">
                <i class="fa-solid fa-basket-shopping text-muted opacity-50 display-1"></i>
            </div>
            <h4 class="fw-bold text-dark mb-2">Your Cart is Currently Empty</h4>
            <p class="text-muted fs-6 mb-4">Explore our vast library of bestsellers, textbooks, and classics!</p>
            <div>
                <a asp-controller="Home" asp-action="Index" class="btn btn-fk-buy px-4 py-2 rounded-pill">
                    Shop Now
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            
            <!-- Left Column: Cart Items List -->
            <div class="col-12 col-lg-8">
                
                <!-- Email Confirmation Alert if needed -->
                @if (!Model.orderHeader.ApplicationUser.EmailConfirmed)
                {
                    <div class="alert alert-warning border-warning shadow-2xs mb-3">
                        <form method="post" class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
                            <div class="@ViewBag.EmailCss fs-7">
                                <i class="fa-solid fa-triangle-exclamation me-1"></i> @ViewBag.EmailMessage
                            </div>
                            <button type="submit" class="btn btn-warning btn-sm font-bold text-dark">
                                Resend Email Confirmation
                            </button>
                        </form>
                    </div>
                }

                <div class="cart-card-shadow overflow-hidden">
                    
                    <!-- Select All Bar -->
                    <div class="p-3 border-bottom bg-light d-flex align-items-center justify-content-between">
                        <div class="form-check mb-0">
                            <input class="form-check-input" type="checkbox" id="selectAll" checked style="cursor:pointer; width: 20px; height: 20px;" />
                            <label class="form-check-label font-bold text-dark ms-2 fs-6" for="selectAll" style="cursor:pointer;">
                                Select All Items
                            </label>
                        </div>
                        <span class="fs-8 text-muted"><i class="fa-solid fa-truck-fast text-success me-1"></i> Free Shipping Eligible</span>
                    </div>

                    <!-- Cart Item Rows -->
                    <div class="cart-items-wrapper">
                        @foreach (var list in Model.ListCart)
                        {
                            <div class="cart-item-row">
                                <div class="row align-items-center g-3">
                                    
                                    <!-- Checkbox column -->
                                    <div class="col-auto">
                                        <input type="checkbox"
                                               class="cart-item-checkbox form-check-input"
                                               value="@list.Id"
                                               data-item-total="@(list.price * list.Count)"
                                               checked
                                               style="cursor:pointer; width: 19px; height: 19px;" />
                                    </div>

                                    <!-- Product Image column -->
                                    <div class="col-3 col-sm-2 text-center">
                                        <img src="@list.product.Imageurl" class="img-fluid rounded border p-1 bg-white" style="max-height: 90px; object-fit: contain;" />
                                    </div>

                                    <!-- Title & Details column -->
                                    <div class="col-8 col-sm-5 col-md-5">
                                        <h6 class="fw-bold text-dark mb-1 text-truncate">@list.product.Title</h6>
                                        <div class="text-muted fs-8 mb-2 line-clamp-2" style="max-height: 38px; overflow: hidden;">
                                            @Html.Raw(list.product.Description)
                                        </div>
                                        <div class="fw-semibold text-fk-green fs-7">
                                            $@list.price.ToString("0.00") <span class="text-muted font-normal fs-8">per unit</span>
                                        </div>
                                    </div>

                                    <!-- Quantity Increment / Decrement & Price column -->
                                    <div class="col-12 col-sm-4 col-md-4 text-sm-end">
                                        <div class="fw-bold text-dark fs-5 mb-2">
                                            $@((list.price * list.Count).ToString("0.00"))
                                        </div>
                                        <div class="d-inline-flex align-items-center border rounded p-1 bg-white shadow-2xs gap-1">
                                            <a asp-action="minus" asp-route-id="@list.Id" class="btn btn-sm btn-light border-0 px-2 text-dark">
                                                <i class="fa-solid fa-minus fs-8"></i>
                                            </a>
                                            <span class="px-3 fw-bold fs-7">@list.Count</span>
                                            <a asp-action="plus" asp-route-id="@list.Id" class="btn btn-sm btn-light border-0 px-2 text-dark">
                                                <i class="fa-solid fa-plus fs-8"></i>
                                            </a>
                                        </div>
                                        <a asp-action="Delete" asp-route-id="@list.Id" class="btn btn-sm btn-link text-danger text-decoration-none ms-2" title="Remove Item">
                                            <i class="fa-solid fa-trash-can"></i> Remove
                                        </a>
                                    </div>

                                </div>
                            </div>
                        }
                    </div>

                </div>
            </div>

            <!-- Right Column: Sticky Price Details Summary -->
            <div class="col-12 col-lg-4">
                <div class="cart-card-shadow p-4 position-sticky" style="top: 90px;">
                    
                    <h6 class="fw-bold text-uppercase text-muted border-bottom pb-3 mb-3 fs-7 tracking-wider">
                        PRICE DETAILS
                    </h6>

                    <div class="d-flex justify-content-between mb-3 fs-6">
                        <span class="text-secondary">Price Items Subtotal</span>
                        <span class="fw-bold text-dark">$<span id="txtOrderTotal">@Model.orderHeader.OrderTotal.ToString("0.00")</span></span>
                    </div>

                    <div class="d-flex justify-content-between mb-3 fs-6">
                        <span class="text-secondary">Delivery Charges</span>
                        <span class="text-success fw-bold">FREE</span>
                    </div>

                    <div class="d-flex justify-content-between mb-3 fs-6">
                        <span class="text-secondary">Secured Packaging Fee</span>
                        <span class="text-success fw-bold">FREE</span>
                    </div>

                    <hr class="my-3">

                    <div class="d-flex justify-content-between mb-4 fs-5 fw-extrabold text-dark">
                        <span>Total Amount</span>
                        <span class="text-primary">$<span class="order-total-display">@Model.orderHeader.OrderTotal.ToString("0.00")</span></span>
                    </div>

                    @if (Model.orderHeader.ApplicationUser.EmailConfirmed)
                    {
                        <button type="button" id="btnProceedToSummary" class="btn btn-fk-buy btn-lg w-100 py-3 rounded-3 fs-6 tracking-wide">
                            PROCEED TO CHECKOUT
                        </button>
                    }
                    else
                    {
                        <button type="button" disabled class="btn btn-secondary btn-lg w-100 py-3 rounded-3 fs-6">
                            PLEASE CONFIRM EMAIL TO PROCEED
                        </button>
                    }

                    <div class="mt-3 text-center fs-8 text-muted">
                        <i class="fa-solid fa-shield-halved text-success me-1"></i> Safe and Secure Payments. 100% Authentic Products.
                    </div>

                </div>
            </div>

        </div>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            function recalculateOrderTotal() {
                var total = 0;
                var anyChecked = false;

                $(".cart-item-checkbox:checked").each(function () {
                    total += parseFloat($(this).data("item-total"));
                    anyChecked = true;
                });

                $("#txtOrderTotal").text(total.toFixed(2));
                $(".order-total-display").text(total.toFixed(2));

                if (!anyChecked) {
                    $("#btnProceedToSummary").prop("disabled", true).addClass("disabled");
                } else {
                    $("#btnProceedToSummary").prop("disabled", false).removeClass("disabled");
                }
            }

            $("#selectAll").on("change", function () {
                var isChecked = $(this).is(":checked");
                $(".cart-item-checkbox").prop("checked", isChecked);
                recalculateOrderTotal();
            });

            $(".cart-item-checkbox").on("change", function () {
                var allChecked = $(".cart-item-checkbox:checked").length === $(".cart-item-checkbox").length;
                $("#selectAll").prop("checked", allChecked);
                recalculateOrderTotal();
            });

            $("#btnProceedToSummary").on("click", function () {
                var selectedIds = [];
                $(".cart-item-checkbox:checked").each(function () {
                    selectedIds.push($(this).val());
                });

                if (selectedIds.length === 0) {
                    alert("Please select at least one book to proceed to checkout!");
                    return;
                }
                
                window.location.href = '@Url.Action("Summary", "Cart")?selectedIds=' + selectedIds.join(',');
            });

            recalculateOrderTotal();
        });
    </script>
}