@model ecom_bookshopping_1003.Models.ShoppingCart

@{
    ViewData["Title"] = Model.product?.Title + " - BookKart";
}

<!-- Breadcrumbs Nav -->
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb fs-7">
        <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none text-muted"><i class="fa-solid fa-house me-1"></i> Home</a></li>
        <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none text-muted">Books</a></li>
        <li class="breadcrumb-item text-muted">@Model.product?.Category?.Name</li>
        <li class="breadcrumb-item active text-truncate fw-semibold" style="max-width: 250px;" aria-current="page">@Model.product?.Title</li>
    </ol>
</nav>

<form method="post">
    <input type="hidden" asp-for="@Model.ProductId" />

    <div class="card border-0 shadow-sm rounded-3 overflow-hidden mb-5">
        <div class="card-body p-4 p-lg-5">
            
            <div class="row g-4 g-lg-5">
                
                <!-- Left Column: Product Image Gallery & Trust Badges -->
                <div class="col-12 col-lg-5">
                    <div class="position-sticky" style="top: 90px;">
                        
                        <!-- Main Image Container -->
                        <div class="bg-light rounded-3 p-4 text-center border position-relative mb-3">
                            
                            @if (ViewBag.IsClearance == true)
                            {
                                <span class="position-absolute top-0 start-0 bg-danger text-white fw-bold px-3 py-1 m-3 rounded shadow-2xs fs-7">
                                    <i class="fa-solid fa-fire me-1"></i> 10% OFF CLEARANCE
                                </span>
                            }

                            <img src="@Model.product.Imageurl"
                                 class="img-fluid rounded shadow-sm product-detail-image"
                                 style="max-height: 420px; object-fit: contain;"
                                 alt="@Model.product.Title" />
                        </div>

                        <!-- Trust Features Widget -->
                        <div class="row g-2 text-center text-muted fs-8">
                            <div class="col-4">
                                <div class="p-2 border rounded bg-white">
                                    <i class="fa-solid fa-rotate-left text-primary fs-5 mb-1 d-block"></i>
                                    <span>7 Day Replacement</span>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="p-2 border rounded bg-white">
                                    <i class="fa-solid fa-truck-fast text-success fs-5 mb-1 d-block"></i>
                                    <span>Free Delivery</span>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="p-2 border rounded bg-white">
                                    <i class="fa-solid fa-shield-halved text-warning fs-5 mb-1 d-block"></i>
                                    <span>Verified Quality</span>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

                <!-- Right Column: Product Info & Actions -->
                <div class="col-12 col-lg-7">
                    
                    <!-- Title & Author -->
                    <h1 class="fw-extrabold text-dark mb-1 h2 tracking-tight">@Model.product.Title</h1>
                    <p class="text-muted fs-6 mb-3">
                        By <span class="text-primary fw-semibold">@Model.product.Author</span>
                    </p>

                    <!-- Rating & Category Pill Badges -->
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-4">
                        <div class="book-rating-badge px-2 py-1 fs-7">
                            <span>4.5</span> <i class="fa-solid fa-star fs-9 ms-1"></i>
                        </div>
                        <span class="text-muted fs-7 me-2">128 Ratings & 34 Reviews</span>
                        
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1-5 rounded-pill fs-8">
                            <i class="fa-solid fa-tag me-1"></i> @Model.product.Category?.Name
                        </span>

                        <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle px-3 py-1-5 rounded-pill fs-8">
                            <i class="fa-solid fa-book-bookmark me-1"></i> @Model.product.CoverType?.Name
                        </span>

                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-3 py-1-5 rounded-pill fs-8">
                            ISBN: @Model.product.ISBN
                        </span>
                    </div>

                    <!-- Price Header Section -->
                    <div class="p-3 bg-light rounded-3 border mb-4">
                        <div class="d-flex align-items-baseline gap-3">
                            <span class="display-6 fw-extrabold text-dark">$@Model.product.Price100.ToString("0.00")</span>
                            
                            @if (Model.product.ListPrice > Model.product.Price100)
                            {
                                <span class="text-muted fs-5 text-decoration-line-through">$@Model.product.ListPrice.ToString("0.00")</span>
                                var discount = (int)Math.Round(((Model.product.ListPrice - Model.product.Price100) / Model.product.ListPrice) * 100);
                                <span class="text-success fw-bold fs-6">@discount% OFF</span>
                            }
                        </div>
                        <p class="text-muted fs-8 mb-0 mt-1"><i class="fa-solid fa-circle-info text-info me-1"></i> Inclusive of all taxes. Volume pricing applies automatically in cart.</p>
                    </div>

                    @if (ViewBag.IsClearance == true)
                    {
                        <div class="alert alert-warning border-warning border-opacity-50 d-flex align-items-center mb-4">
                            <i class="fa-solid fa-fire text-danger fs-4 me-3"></i>
                            <div>
                                <strong>Clearance Sale Bonus!</strong> Extra 10% instant discount will be automatically applied at final checkout.
                            </div>
                        </div>
                    }

                    <!-- Volume Tiered Pricing Table -->
                    <div class="mb-4">
                        <h6 class="fw-bold text-dark text-uppercase fs-7 mb-2 tracking-wider">
                            <i class="fa-solid fa-layer-group text-primary me-1"></i> Volume Discount Structure
                        </h6>
                        <div class="table-responsive rounded border">
                            <table class="table table-bordered table-sm text-center align-middle mb-0">
                                <thead class="table-light fs-7">
                                    <tr>
                                        <th>Quantity Tier</th>
                                        <th>1 - 49 Units</th>
                                        <th>50 - 99 Units</th>
                                        <th>100+ Units</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <th class="bg-light text-muted fs-7">Unit Price</th>
                                        <td class="text-dark fw-semibold">$@Model.product.Price.ToString("0.00")</td>
                                        <td class="text-dark fw-semibold">$@Model.product.Price50.ToString("0.00")</td>
                                        <td class="text-success fw-bold">$@Model.product.Price100.ToString("0.00")</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Description Block -->
                    <div class="mb-4">
                        <h6 class="fw-bold text-dark text-uppercase fs-7 mb-2 tracking-wider">Book Overview</h6>
                        <div class="text-secondary fs-6 lh-relaxed border-top pt-3">
                            @Html.Raw(Model.product.Description)
                        </div>
                    </div>

                    <!-- Quantity Input & Live Interactive Savings Calculator Widget -->
                    <div class="p-3 bg-white rounded-3 border shadow-2xs mb-4">
                        <div class="row align-items-center g-3">
                            <div class="col-auto">
                                <label for="inputCount" class="fw-bold text-dark mb-0 fs-6">Quantity:</label>
                            </div>
                            <div class="col-5 col-sm-3">
                                <input type="number"
                                       id="inputCount"
                                       min="1"
                                       asp-for="@Model.Count"
                                       class="form-control form-control-lg text-center fw-bold border-2" />
                            </div>
                            <div class="col-12 col-sm-auto ms-sm-auto">
                                <div class="p-2-5 bg-success-subtle text-success-emphasis rounded border border-success-subtle text-center">
                                    <div class="fs-8 text-uppercase fw-bold text-muted">Estimated Total</div>
                                    <div class="fs-5 fw-extrabold text-success" id="calcTotalPrice">$@Model.product.Price.ToString("0.00")</div>
                                    <div class="fs-9 fw-semibold text-success" id="calcSavingsBadge">You Save: $0.00</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Action Buttons CTAs -->
                    <div class="row g-3">
                        <div class="col-12 col-sm-6">
                            <button type="submit" class="btn btn-fk-addcart btn-lg w-100 py-3 rounded-3 fs-6 d-flex align-items-center justify-content-center gap-2">
                                <i class="fa-solid fa-cart-plus fs-5"></i>
                                <span>ADD TO CART</span>
                            </button>
                        </div>
                        <div class="col-12 col-sm-6">
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg w-100 py-3 rounded-3 fs-6 d-flex align-items-center justify-content-center gap-2">
                                <i class="fa-solid fa-arrow-left"></i>
                                <span>CONTINUE SHOPPING</span>
                            </a>
                        </div>
                    </div>

                </div>

            </div>

        </div>
    </div>

    <!-- Sticky Mobile Quick-Buy Bottom Bar (Smartphone PDP Only) -->
    <div class="d-md-none fixed-bottom bg-white border-top shadow-lg p-2 z-3" style="bottom: 50px;">
        <div class="d-flex align-items-center justify-content-between gap-2">
            <div>
                <div class="fs-8 font-bold text-dark text-truncate" style="max-width: 150px;">@Model.product.Title</div>
                <div class="fs-6 fw-extrabold text-primary">$@Model.product.Price.ToString("0.00")</div>
            </div>
            <button type="submit" class="btn btn-fk-addcart btn-sm px-4 py-2 rounded-2 fw-bold">
                <i class="fa-solid fa-cart-plus me-1"></i> ADD TO CART
            </button>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        $(document).ready(function () {
            var price1 = @Model.product.Price;
            var price50 = @Model.product.Price50;
            var price100 = @Model.product.Price100;
            var listPrice = @Model.product.ListPrice;

            function calculateSavings() {
                var qty = parseInt($("#inputCount").val()) || 1;
                if (qty < 1) qty = 1;

                var unitPrice = price1;
                if (qty >= 100) {
                    unitPrice = price100;
                } else if (qty >= 50) {
                    unitPrice = price50;
                }

                var total = qty * unitPrice;
                var baseTotal = qty * (listPrice > 0 ? listPrice : price1);
                var savings = baseTotal - total;

                $("#calcTotalPrice").text("$" + total.toFixed(2));
                if (savings > 0) {
                    $("#calcSavingsBadge").text("🎉 Instant Savings: $" + savings.toFixed(2)).show();
                } else {
                    $("#calcSavingsBadge").text("Best Direct Value Rate").show();
                }
            }

            $("#inputCount").on("input change keyup", function () {
                calculateSavings();
            });

            calculateSavings();
        });
    </script>
}
