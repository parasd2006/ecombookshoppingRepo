@{
    ViewData["Title"] = "Order Details #" + Model.Id + " - Admin";
}

<div class="card border-0 shadow-sm rounded-3 overflow-hidden mb-4">
    <div class="card-header bg-white border-bottom py-3 px-4 d-flex align-items-center justify-content-between">
        <div>
            <h4 class="fw-extrabold text-dark mb-0">
                <i class="fa-solid fa-receipt text-primary me-2"></i> Order Breakdown <span class="text-primary">#@Model.Id</span>
            </h4>
            <span class="fs-7 text-muted">Detailed itemized list and pricing total</span>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm font-semibold rounded-pill px-3">
            <i class="fa-solid fa-arrow-left me-1"></i> Back to Orders List
        </a>
    </div>

    <div class="card-body p-4">
        <div class="table-responsive rounded border mb-3">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-dark fs-7">
                    <tr>
                        <th>Book Title</th>
                        <th>Author</th>
                        <th>Unit Price</th>
                        <th class="text-center">Quantity</th>
                        <th class="text-end">Item Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in ViewBag.OrderDetails)
                    {
                        <tr>
                            <td class="fw-bold text-dark fs-7">@item.Product.Title</td>
                            <td class="text-muted fs-7">@item.Product.Author</td>
                            <td class="fs-7">$@item.Price.ToString("0.00")</td>
                            <td class="text-center fw-bold fs-7">@item.Count</td>
                            <td class="text-end fw-bold text-dark fs-7">$@((item.Price * item.Count).ToString("0.00"))</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="table-light fw-extrabold fs-5">
                        <td colspan="4" class="text-end text-uppercase text-muted fs-7">Grand Total Amount:</td>
                        <td class="text-end text-primary">$@Model.OrderTotal.ToString("N2")</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>