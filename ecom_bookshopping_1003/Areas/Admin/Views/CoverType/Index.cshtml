@{
    ViewData["Title"] = "Cover Type Management - Admin";
}

<div class="card border-0 shadow-sm rounded-3 overflow-hidden mb-4">
    <div class="card-header bg-white border-bottom py-3 px-4 d-flex align-items-center justify-content-between">
        <div>
            <h4 class="fw-extrabold text-dark mb-0"><i class="fa-solid fa-book-bookmark text-primary me-2"></i> Cover Type Management</h4>
            <span class="fs-7 text-muted">Manage book cover bindings (Hardcover, Paperback, eBook, etc.)</span>
        </div>
        <a asp-action="Upsert" class="btn btn-primary font-bold px-3 py-2 rounded-2 shadow-2xs">
            <i class="fa-solid fa-plus me-1"></i> Add New Cover Type
        </a>
    </div>

    <div class="card-body p-4">
        <div class="table-responsive rounded border">
            <table id="tablData" class="table table-hover table-striped align-middle mb-0 w-100">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 20%;" class="text-center">Edit</th>
                        <th>Cover Type Name</th>
                        <th style="width: 20%;" class="text-center">Delete</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/CoverType.js"></script>
}